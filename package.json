{
  "name": "temporal-kit",
  "version": "0.4.0",
  "description": "A modern, functional utility library for the Temporal API - experiment with Temporal today.",
  "type": "module",
  "sideEffects": [
    "./dist/polyfilled.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./polyfilled": {
      "types": "./dist/polyfilled.d.ts",
      "import": "./dist/polyfilled.js",
      "default": "./dist/polyfilled.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.js",
    "build": "node --run clean && node --run build:modules && node --run build:browser",
    "build:modules": "tsc --project tsconfig.build.json --noEmit false --outDir dist",
    "build:browser": "esbuild src/index.ts --bundle --format=iife --global-name=TemporalKit --target=esnext --minify --sourcemap --outfile=dist/temporal-kit.browser.global.js && esbuild src/polyfilled.ts --bundle --format=iife --global-name=TemporalKit --target=esnext --minify --sourcemap --outfile=dist/temporal-kit.browser.polyfilled.global.js",
    "dev": "node --run clean && tsc --project tsconfig.build.json --noEmit false --outDir dist --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ci": "node --run typecheck && node --run typecheck:tests && node --run lint && node --run test:coverage && node --run build",
    "prepublishOnly": "node --run ci",
    "release": "node --run ci && commit-and-tag-version --npmPublishHint \"npm run release:publish\"",
    "release:minor": "node --run ci && commit-and-tag-version --release-as minor --npmPublishHint \"npm run release:publish\"",
    "release:major": "node --run ci && commit-and-tag-version --release-as major --npmPublishHint \"npm run release:publish\"",
    "release:publish": "node scripts/publish-release.js",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "node --run typecheck && npx lint-staged",
    "commit-msg": "npx commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,ts,json,md,yml}": [
      "biome check --write"
    ]
  },
  "keywords": [
    "temporal",
    "temporal-api",
    "temporal-polyfill",
    "date",
    "time",
    "datetime",
    "timezone",
    "date-utilities",
    "date-helpers",
    "functional",
    "immutable",
    "tree-shakable",
    "typescript",
    "startof",
    "endof"
  ],
  "author": "KristjanESPERANTO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KristjanESPERANTO/temporal-kit.git"
  },
  "bugs": {
    "url": "https://github.com/KristjanESPERANTO/temporal-kit/issues"
  },
  "homepage": "https://kristjanesperanto.github.io/temporal-kit/",
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "commit-and-tag-version": "^13.3.0",
    "fast-check": "^4.10.2",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "temporal-polyfill": "^1.0.7",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "temporal-spec": "^1.0.1"
  },
  "peerDependencies": {
    "temporal-polyfill": "^1.0.7"
  },
  "peerDependenciesMeta": {
    "temporal-polyfill": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true,
    "esbuild@0.28.2": true
  }
}
